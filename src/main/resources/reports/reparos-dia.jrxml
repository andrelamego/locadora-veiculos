<jasperReport name="reparos-dia" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="06369b28-c64f-4446-a63d-f3325fba3754">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <style name="Title" fontName="Arial" fontSize="26.0" bold="true"/>
    <style name="SubTitle" forecolor="#666666" fontName="Arial" fontSize="14.0"/>
    <style name="Column header" forecolor="#666666" fontName="Arial" fontSize="8.0" bold="true"/>
    <style name="Detail" fontName="Arial" fontSize="8.0"/>

    <parameter name="DATA_CONSULTA" class="java.sql.Date"/>

    <query language="sql"><![CDATA[
SELECT
    reparo_id,
    placa,
    marca,
    modelo,
    cor,
    ano,
    data_entrada,
    quantidade_dias,
    data_prevista_saida,
    descricao_problema,
    valor_reparo,
    status
FROM dbo.fn_reparos_no_dia($P{DATA_CONSULTA})
ORDER BY data_entrada, marca, modelo
    ]]></query>

    <field name="reparo_id" class="java.lang.Long"/>
    <field name="placa" class="java.lang.String"/>
    <field name="marca" class="java.lang.String"/>
    <field name="modelo" class="java.lang.String"/>
    <field name="cor" class="java.lang.String"/>
    <field name="ano" class="java.lang.Integer"/>
    <field name="data_entrada" class="java.sql.Date"/>
    <field name="quantidade_dias" class="java.lang.Integer"/>
    <field name="data_prevista_saida" class="java.sql.Date"/>
    <field name="descricao_problema" class="java.lang.String"/>
    <field name="valor_reparo" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>

