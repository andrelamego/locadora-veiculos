<jasperReport name="historico-cliente" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="cc9bd414-95ef-422d-a13c-fc88784b01eb">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <style name="Title" fontName="Arial" fontSize="26.0" bold="true"/>
    <style name="SubTitle" forecolor="#666666" fontName="Arial" fontSize="14.0"/>
    <style name="Column header" forecolor="#666666" fontName="Arial" fontSize="8.0" bold="true"/>
    <style name="Detail" fontName="Arial" fontSize="8.0"/>

    <parameter name="CPF_CLIENTE" class="java.lang.String"/>

    <query language="sql"><![CDATA[
SELECT
    cpf,
    nome,
    numero_habilitacao,
    data_nascimento,
    logradouro,
    numero,
    cep,
    cidade,
    placa,
    marca,
    modelo,
    cor,
    ano,
    locacao_id,
    data_retirada,
    quantidade_dias,
    data_prevista_devolucao,
    status_locacao,
    data_devolucao,
    valor_locacao,
    valor_combustivel,
    valor_total
FROM dbo.fn_historico_cliente($P{CPF_CLIENTE})
ORDER BY data_retirada DESC, locacao_id DESC
    ]]></query>

    <field name="cpf" class="java.lang.String"/>
    <field name="nome" class="java.lang.String"/>
    <field name="numero_habilitacao" class="java.lang.String"/>
    <field name="data_nascimento" class="java.sql.Date"/>
    <field name="logradouro" class="java.lang.String"/>
    <field name="numero" class="java.lang.String"/>
